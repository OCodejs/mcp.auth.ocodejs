# Copy into Vercel Environment Variables or a local .env file.
# Never commit real credentials.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# PostgreSQL connection string; use a dedicated database and back it up before schema changes.
DATABASE_URL=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# OAuth callback URLs:
# Google: https://YOUR-DOMAIN/api/auth/callback/google
# GitHub: https://YOUR-DOMAIN/api/auth/callback/github