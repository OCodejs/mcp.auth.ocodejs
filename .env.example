# Local development only. Never commit real credentials.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Use a dedicated Preview PostgreSQL database; do not point Preview at production.
DATABASE_URL=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# OAuth callback URLs on the Cloudflare Preview host:
# Google: https://<PREVIEW_HOST>/api/auth/callback/google
# GitHub: https://<PREVIEW_HOST>/api/auth/callback/github
