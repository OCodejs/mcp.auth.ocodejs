# Local development only. Never commit real credentials.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Preview schema writes are disabled by default. Set true only on a verified Vercel Preview target.
AUTH_PREVIEW_DB_PUSH=false
# Exact host:port/database allowlist; include direct and pooled endpoints if both are configured.
# Example: db-preview.example:5432/authdb,pool-preview.example:6432/authdb
AUTH_PREVIEW_DB_TARGETS=

# Prisma Postgres: use the pooled URL at runtime and the direct URL for Prisma CLI.
DATABASE_URL=
DATABASE_URL_POOLED=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional upstream enterprise OIDC. Configure all three together; use an HTTPS issuer outside local development.
# Callback: https://<VERIFIED_PREVIEW_HOST>/api/auth/callback/ocodejs-oidc
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=

# OAuth callback URLs on the Preview host:
# Google: https://<PREVIEW_HOST>/api/auth/callback/google
# GitHub: https://<PREVIEW_HOST>/api/auth/callback/github

# Preview-only server-to-server Token Vault integration. Never expose as NEXT_PUBLIC_*.
TOKEN_VAULT_URL=
TOKEN_VAULT_ASSERTION_SECRET=
