# Build only on a dedicated rootless builder with host-enforced egress firewall.
# Runtime containers created by AutoRun MUST use --network none.
FROM node:22.14.0-bookworm-slim

ENV CI=true \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false

WORKDIR /opt/auth

# Copy lock inputs first so Docker cache is keyed by the exact dependency graph.
COPY package.json package-lock.json ./
COPY prisma/schema.prisma ./prisma/schema.prisma

# HTTPS_PROXY is mandatory. The builder host must firewall direct egress and
# permit only the proxy to reach the explicit npm/Prisma allowlist.
ARG HTTPS_PROXY
ARG LOCK_SHA256
ARG SOURCE_SHA
RUN test -n "$HTTPS_PROXY" \
 && test -n "$LOCK_SHA256" \
 && test -n "$SOURCE_SHA" \
 && printf '%s  package-lock.json\n' "$LOCK_SHA256" | sha256sum -c - \
 && npm_config_https_proxy="$HTTPS_PROXY" npm_config_proxy="$HTTPS_PROXY" npm ci \
 && npm_config_https_proxy="$HTTPS_PROXY" npm_config_proxy="$HTTPS_PROXY" npx --no-install prisma generate \
 && node -e "const p=require('./node_modules/@prisma/client/package.json'); if(!p.version.startsWith('6.19.3')) process.exit(2)" \
 && npm cache clean --force

LABEL org.ocodejs.autorun.source-sha="$SOURCE_SHA" \
      org.ocodejs.autorun.lock-sha256="$LOCK_SHA256" \
      org.ocodejs.autorun.prisma-version="6.19.3"

# Keep the dependency payload inert. The isolated job supplies its own command.
CMD ["node", "-e", "setInterval(() => {}, 3600000)"]
