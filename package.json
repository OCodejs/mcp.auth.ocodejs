{
  "name": "mcp-server-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:cloudflare": "prisma generate && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@opennextjs/cloudflare": "latest",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.3",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "6.19.3",
    "typescript": "^5.9.2",
    "wrangler": "latest"
  }
}
